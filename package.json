{
  "name": "scriptiz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ui": "pnpm --filter mcp-ui-web dev",
    "dev:docs": "pnpm --filter @scriptiz/docs dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run build",
    "test": "vitest run",
    "test:unit": "vitest run packages/core packages/schemas packages/extractor-ytdlp packages/mcp-ui packages/mcp-tools packages/stt-openai packages/stt-xai packages/storage-filesystem packages/queue-local apps/worker tests",
    "test:integration": "vitest run tests/integration",
    "test:adapter": "vitest run packages/extractor-ytdlp",
    "test:e2e": "vitest run tests/e2e",
    "test:docker-smoke": "bash scripts/docker-smoke.sh",
    "test:docker-compose-smoke": "bash scripts/docker-compose-health-smoke.sh",
    "docker:build:mcp": "docker build -f docker/Dockerfile.mcp-all-in-one -t scriptiz-mcp:local .",
    "test:docker-mcp-smoke": "bash scripts/docker-mcp-smoke.sh",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scriptiz/extractor-ytdlp": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
