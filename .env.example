# Copy to `.env` and fill in (`.env` is gitignored):
#   cp .env.example .env
# Docker Compose automatically loads `.env` from the project root for ${VAR} substitution.

# --- Data (local: defaults to $HOME/.scriptiz when unset) ---
# DATA_DIR=/path/to/data

# --- Language defaults (BCP-47 / ISO-639-1, e.g. en, ko) ---
DEFAULT_TRANSCRIPT_LANGUAGE=ko
# Optional alias for MCP context when DEFAULT_TRANSCRIPT_LANGUAGE is unset
# DEFAULT_LANGUAGE=

# --- Worker ---
WORKER_POLL_INTERVAL_MS=2000
# Requeue jobs stuck in running/ if updatedAt older than this (ms). Default 30m.
# WORKER_STALE_JOB_AFTER_MS=1800000
# M6: no-caption STT — set one API key. Optional: openai | xai (default: prefer OPENAI, then XAI)
# STT_PROVIDER=
# OPENAI_API_KEY=
# XAI_API_KEY=
# STT_TIMEOUT_MS=300000
# STT_MAX_AUDIO_BYTES=26214400

# --- yt-dlp subprocess (worker) ---
# YTDLP_TIMEOUT_MS=600000

# --- MCP server (non-Docker: stdio; Docker: set SCRIPTIZ_MCP_START_STDIO=0) ---
# SCRIPTIZ_MCP_START_STDIO=1
# HEALTH_CHECK_PORT=8080

# --- YouTube / yt-dlp (optional override) ---
# YT_DLP_PATH=yt-dlp

# --- E2E (vitest) ---
# E2E_YOUTUBE_URL=https://www.youtube.com/watch?v=...
